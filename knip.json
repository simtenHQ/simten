{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["picocom", "wrangler"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "bench/*.mts", "e2e/*.mts"]
    },
    "apps/game": {
      "entry": ["src/router.tsx", "src/routes/**/*.tsx", "src/game/solutions/*.ts"]
    },
    "apps/web": {
      "entry": [
        "src/router.tsx",
        "src/routes/**/*.{ts,tsx}",
        "scripts/build.mjs",
        "source.config.ts",
        "viewer/stubs/share-server.ts",
        "src/features/docs/*.tsx",
        "src/features/splash/circuits.ts",
        "src/**/*.verify.ts"
      ],
      "ignore": [".source/**", "public/blog-assets/wasm/**"],
      "ignoreDependencies": ["cloudflare"]
    },
    "apps/embed-page": {
      "entry": ["e2e/*.mts"]
    },
    "apps/sandbox": {
      "entry": ["e2e/*.mts"]
    },
    "demos": {
      "entry": ["cli/*.ts"]
    },
    "hardware/ulx3s": {
      "entry": [
        "run_on_fpga.ts",
        "cpu_build.ts",
        "projects/*/index.ts",
        "projects/cpu/{tests,verify,run_c,regen_verilog,dump-netlist,sim,cycle-diff}.ts",
        "projects/cpu/archtest/{run-suite,run-dut,fault-check}.ts",
        "projects/**/*.verify.ts",
        "projects/snake/{parity-check,playable-check,fault-check}.ts"
      ]
    },
    "packages/core": {
      "entry": [
        "src/index.ts",
        "src/circuit/index.ts",
        "src/std/index.ts",
        "src/verify/index.ts",
        "src/verilog/index.ts",
        "src/examples/index.ts",
        "src/internal.ts",
        "src/editor-types.ts",
        "rollup.dts.config.mjs",
        "scripts/*.{ts,mjs}",
        "bench/run.ts",
        "src/**/*.verify.ts",
        "src/verify/__fixtures__/*.ts",
        "src/std/__tests__/mos6502/*.ts"
      ]
    },
    "packages/mcp": {
      "entry": [
        "src/index.ts",
        "src/schemas/index.ts",
        "src/lib/file-runner.ts",
        "bin/simten-mcp.js",
        "scripts/*.mjs"
      ]
    },
    "packages/react": {
      "entry": [
        "src/canvas/index.ts",
        "src/embed/index.ts",
        "src/monaco/index.ts",
        "src/nodes/index.ts",
        "src/sandbox/index.ts",
        "src/share/index.ts",
        "src/waveform/WaveformViewer.tsx",
        "src/primitives/{tooltip,resizable,sheet,dialog,button}.tsx",
        "scripts/*.mjs"
      ]
    },
    "packages/sandbox": {
      "entry": ["src/index.ts", "src/protocol.ts", "src/host.ts"]
    }
  },
  "ignoreIssues": {
    "apps/web/src/components/Logo.tsx": ["exports"],
    "packages/core/src/import/primitives.ts": ["exports"]
  }
}
