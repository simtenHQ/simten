LOCATE COMP "clk_25mhz" SITE "G2";
IOBUF  PORT "clk_25mhz" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk_25mhz" 25 MHZ;

# Buttons. PWR is active low; the rest are active high.
LOCATE COMP "btn[0]" SITE "D6";  IOBUF PORT "btn[0]" PULLMODE=UP   IO_TYPE=LVCMOS33;  # PWR   -> Start
LOCATE COMP "btn[1]" SITE "R1";  IOBUF PORT "btn[1]" PULLMODE=DOWN IO_TYPE=LVCMOS33;  # F1    -> A
LOCATE COMP "btn[2]" SITE "T1";  IOBUF PORT "btn[2]" PULLMODE=DOWN IO_TYPE=LVCMOS33;  # F2    -> B
LOCATE COMP "btn[3]" SITE "R18"; IOBUF PORT "btn[3]" PULLMODE=DOWN IO_TYPE=LVCMOS33;  # up
LOCATE COMP "btn[4]" SITE "V1";  IOBUF PORT "btn[4]" PULLMODE=DOWN IO_TYPE=LVCMOS33;  # down
LOCATE COMP "btn[5]" SITE "U1";  IOBUF PORT "btn[5]" PULLMODE=DOWN IO_TYPE=LVCMOS33;  # left
LOCATE COMP "btn[6]" SITE "H16"; IOBUF PORT "btn[6]" PULLMODE=DOWN IO_TYPE=LVCMOS33;  # right

# USB serial from the computer (FTDI TXD -> FPGA), for loading games.
LOCATE COMP "ftdi_txd" SITE "M1"; IOBUF PORT "ftdi_txd" PULLMODE=UP IO_TYPE=LVCMOS33;

LOCATE COMP "led[0]" SITE "B2"; IOBUF PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "led[1]" SITE "C2"; IOBUF PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "led[2]" SITE "C1"; IOBUF PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "led[3]" SITE "D2"; IOBUF PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "led[4]" SITE "D1"; IOBUF PORT "led[4]" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "led[5]" SITE "E2"; IOBUF PORT "led[5]" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "led[6]" SITE "E1"; IOBUF PORT "led[6]" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "led[7]" SITE "H3"; IOBUF PORT "led[7]" IO_TYPE=LVCMOS33 DRIVE=4;

# GPDI differential pairs (from emard/ulx3s v20). ch0=Blue ch1=Green ch2=Red ch3=Clock
LOCATE COMP "gpdi_dp[0]" SITE "A16"; IOBUF PORT "gpdi_dp[0]" IO_TYPE=LVCMOS33D DRIVE=4;
LOCATE COMP "gpdi_dn[0]" SITE "B16"; IOBUF PORT "gpdi_dn[0]" IO_TYPE=LVCMOS33  DRIVE=4;
LOCATE COMP "gpdi_dp[1]" SITE "A14"; IOBUF PORT "gpdi_dp[1]" IO_TYPE=LVCMOS33D DRIVE=4;
LOCATE COMP "gpdi_dn[1]" SITE "C14"; IOBUF PORT "gpdi_dn[1]" IO_TYPE=LVCMOS33  DRIVE=4;
LOCATE COMP "gpdi_dp[2]" SITE "A12"; IOBUF PORT "gpdi_dp[2]" IO_TYPE=LVCMOS33D DRIVE=4;
LOCATE COMP "gpdi_dn[2]" SITE "A13"; IOBUF PORT "gpdi_dn[2]" IO_TYPE=LVCMOS33  DRIVE=4;
LOCATE COMP "gpdi_dp[3]" SITE "A17"; IOBUF PORT "gpdi_dp[3]" IO_TYPE=LVCMOS33D DRIVE=4;
LOCATE COMP "gpdi_dn[3]" SITE "B18"; IOBUF PORT "gpdi_dn[3]" IO_TYPE=LVCMOS33  DRIVE=4;
