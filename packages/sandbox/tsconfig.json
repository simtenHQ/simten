{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "references": [{ "path": "../core" }],
  "include": ["src/**/*.ts"],
  // Tests are excluded from the build only: tsconfig.check.json includes them,
  // and `pnpm typecheck` runs it through `typecheck:tests`.
  "exclude": ["node_modules", "dist", "**/__tests__/**", "**/*.test.ts"]
}
