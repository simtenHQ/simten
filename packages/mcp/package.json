{
  "name": "@turing-incomplete/mcp",
  "version": "0.1.0",
  "description": "MCP server for Turing Incomplete. Live circuit simulation with real-time browser push via WebSocket.",
  "license": "BUSL-1.1",
  "author": "Charles Harris",
  "repository": {
    "type": "git",
    "url": "https://github.com/charlesharris/turing-incomplete.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "circuit-simulator",
    "hardware",
    "dsl",
    "websocket",
    "interactive"
  ],
  "type": "module",
  "bin": {
    "turing-mcp": "./bin/turing-mcp.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./schemas": "./dist/schemas/index.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@turing-incomplete/challenges": "workspace:*",
    "@turing-incomplete/core": "workspace:*",
    "ws": "^8.19.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/ws": "^8.18.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
