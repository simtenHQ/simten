{
  "name": "@simten/mcp",
  "version": "0.11.0",
  "description": "MCP server for Simten: check, simulate, verify and show TypeScript circuits, with a live browser canvas.",
  "license": "Apache-2.0",
  "author": "Charles Harris",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simtenHQ/simten.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "circuit-simulator",
    "hardware",
    "circuit",
    "websocket",
    "interactive"
  ],
  "type": "module",
  "bin": {
    "simten-mcp": "./bin/simten-mcp.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "rm -rf dist *.tsbuildinfo && tsc -b && node scripts/copy-editor.mjs",
    "bundle-editor": "node scripts/copy-editor.mjs",
    "prepack": "node scripts/copy-editor.mjs --require",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:tests": "tsc --noEmit -p tsconfig.check.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@simten/core": "workspace:^",
    "tsx": "^4.23.15",
    "ws": "^8.21.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^20",
    "@types/ws": "^8.18.1",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
