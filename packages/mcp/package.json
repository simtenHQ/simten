{
  "name": "@simten/mcp",
  "version": "0.1.0",
  "description": "MCP server for Simten. Live circuit simulation with real-time browser push via WebSocket.",
  "license": "Apache-2.0",
  "author": "Charles Harris",
  "repository": {
    "type": "git",
    "url": "https://github.com/simtenHQ/simten.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "circuit-simulator",
    "hardware",
    "circuit",
    "websocket",
    "interactive"
  ],
  "type": "module",
  "bin": {
    "simten-mcp": "./bin/simten-mcp.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./schemas": {
        "types": "./dist/schemas/index.d.ts",
        "import": "./dist/schemas/index.js"
      }
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@simten/core": "workspace:*",
    "ws": "^8.19.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/ws": "^8.18.1",
    "typescript": "^5",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=20"
  }
}
