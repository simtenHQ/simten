$date
    handcrafted fixture
$end
$version
    synthetic-dumpall
$end
$comment
    Exercises $dumpall (a re-snapshot of all signal values at currentTime,
    syntactically identical to $dumpvars but emitted mid-simulation).
$end
$timescale 1ps $end
$scope module tb $end
$var reg 1 ! clk $end
$var reg 1 " sig $end
$upscope $end
$enddefinitions $end
$dumpvars
0!
0"
$end
