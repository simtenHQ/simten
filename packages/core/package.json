{
  "name": "@simten/core",
  "version": "0.23.0",
  "description": "Simten simulator engine, circuit IR builder, standard library, and Verilog exporter. Pure TypeScript with no browser dependencies.",
  "license": "Apache-2.0",
  "author": "Charles Harris",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simtenHQ/simten.git",
    "directory": "packages/core"
  },
  "keywords": [
    "circuit-simulator",
    "hardware",
    "verilog",
    "digital-logic",
    "hdl",
    "circuit",
    "simulator"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./std": "./src/std/index.ts",
    "./verify": "./src/verify/index.ts",
    "./verilog": "./src/verilog/index.ts",
    "./examples": "./src/examples/index.ts",
    "./internal": "./src/internal.ts",
    "./bundle": "./dist/bundle.d.ts",
    "./editor-globals": "./dist/editor-globals.dts.txt",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./std": {
        "types": "./dist/std/index.d.ts",
        "import": "./dist/std/index.js"
      },
      "./verify": {
        "types": "./dist/verify/index.d.ts",
        "import": "./dist/verify/index.js"
      },
      "./verilog": {
        "types": "./dist/verilog/index.d.ts",
        "import": "./dist/verilog/index.js"
      },
      "./examples": {
        "types": "./dist/examples/index.d.ts",
        "import": "./dist/examples/index.js"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "import": "./dist/internal.js"
      },
      "./bundle": "./dist/bundle.d.ts",
      "./editor-globals": "./dist/editor-globals.dts.txt",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "bench": "tsx bench/run.ts",
    "gen:examples": "tsx scripts/gen-examples.ts",
    "build": "rm -rf dist *.tsbuildinfo && tsc -b && rollup -c rollup.dts.config.mjs && node scripts/build-editor-globals.mjs",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest",
    "typecheck:tests": "tsc --noEmit -p tsconfig.check.json"
  },
  "dependencies": {
    "acorn": "^8.14.1",
    "fast-check": "^4.5.3",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@noble/hashes": "^2.2.0",
    "@types/node": "^20",
    "rollup": "^4.60.3",
    "rollup-plugin-dts": "^6.4.1",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
