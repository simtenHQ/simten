{
  "name": "@simten/core",
  "version": "0.11.1",
  "description": "Simten simulator engine, circuit IR builder, standard library, and Verilog exporter. Pure TypeScript with no browser dependencies.",
  "license": "Apache-2.0",
  "author": "Charles Harris",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simtenHQ/simten.git",
    "directory": "packages/core"
  },
  "keywords": [
    "circuit-simulator",
    "hardware",
    "verilog",
    "digital-logic",
    "hdl",
    "circuit",
    "simulator"
  ],
  "type": "module",
  "sideEffects": [
    "./src/std/**",
    "./dist/std/**",
    "./src/rtl/**",
    "./dist/rtl/**"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./simulator": "./src/simulator/index.ts",
    "./api": "./src/api/index.ts",
    "./verilog": "./src/verilog/index.ts",
    "./circuit": "./src/circuit/index.ts",
    "./std": "./src/std/index.ts",
    "./rtl": "./src/rtl/index.ts",
    "./import": "./src/import/index.ts",
    "./sim": "./src/sim/index.ts",
    "./verify": "./src/verify/index.ts",
    "./examples": "./src/examples/index.ts",
    "./examples/catalog": "./src/examples/catalog.ts",
    "./util/test-name": "./src/util/test-name.ts",
    "./bundle": "./dist/bundle.d.ts",
    "./editor-globals": "./dist/editor-globals.dts.txt",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./simulator": {
        "types": "./dist/simulator/index.d.ts",
        "import": "./dist/simulator/index.js"
      },
      "./api": {
        "types": "./dist/api/index.d.ts",
        "import": "./dist/api/index.js"
      },
      "./verilog": {
        "types": "./dist/verilog/index.d.ts",
        "import": "./dist/verilog/index.js"
      },
      "./circuit": {
        "types": "./dist/circuit/index.d.ts",
        "import": "./dist/circuit/index.js"
      },
      "./std": {
        "types": "./dist/std/index.d.ts",
        "import": "./dist/std/index.js"
      },
      "./sim": {
        "types": "./dist/sim/index.d.ts",
        "import": "./dist/sim/index.js"
      },
      "./verify": {
        "types": "./dist/verify/index.d.ts",
        "import": "./dist/verify/index.js"
      },
      "./examples": {
        "types": "./dist/examples/index.d.ts",
        "import": "./dist/examples/index.js"
      },
      "./examples/catalog": {
        "types": "./dist/examples/catalog.d.ts",
        "import": "./dist/examples/catalog.js"
      },
      "./util/test-name": {
        "types": "./dist/util/test-name.d.ts",
        "import": "./dist/util/test-name.js"
      },
      "./bundle": "./dist/bundle.d.ts",
      "./editor-globals": "./dist/editor-globals.dts.txt",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist *.tsbuildinfo && tsc -b && rollup -c rollup.dts.config.mjs && node scripts/build-editor-globals.mjs",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "acorn": "^8.14.1",
    "fast-check": "^4.5.3",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@noble/hashes": "^2.2.0",
    "@types/node": "^20",
    "rollup": "^4.60.3",
    "rollup-plugin-dts": "^6.4.1",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
