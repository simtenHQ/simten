{
  "name": "@simten/core",
  "version": "0.1.0",
  "description": "Simten simulator engine, circuit IR builder, standard library, and Verilog exporter. Pure TypeScript with no browser dependencies.",
  "license": "BUSL-1.1",
  "author": "Charles Harris",
  "repository": {
    "type": "git",
    "url": "https://github.com/simtenjs/simten.git",
    "directory": "packages/core"
  },
  "keywords": [
    "circuit-simulator",
    "hardware",
    "verilog",
    "digital-logic",
    "hdl",
    "circuit",
    "simulator"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./simulator": "./src/simulator/index.ts",
    "./api": "./src/api/index.ts",
    "./verilog": "./src/verilog/index.ts",
    "./circuit": "./src/circuit/index.ts",
    "./std": "./src/std/index.ts",
    "./sim": "./src/sim/index.ts",
    "./util/test-name": "./src/util/test-name.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./simulator": {
        "types": "./dist/simulator/index.d.ts",
        "import": "./dist/simulator/index.js"
      },
      "./api": {
        "types": "./dist/api/index.d.ts",
        "import": "./dist/api/index.js"
      },
      "./verilog": {
        "types": "./dist/verilog/index.d.ts",
        "import": "./dist/verilog/index.js"
      },
      "./circuit": {
        "types": "./dist/circuit/index.d.ts",
        "import": "./dist/circuit/index.js"
      },
      "./std": {
        "types": "./dist/std/index.d.ts",
        "import": "./dist/std/index.js"
      },
      "./sim": {
        "types": "./dist/sim/index.d.ts",
        "import": "./dist/sim/index.js"
      },
      "./util/test-name": {
        "types": "./dist/util/test-name.d.ts",
        "import": "./dist/util/test-name.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "acorn": "^8.14.1",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "fast-check": "^4.5.3",
    "typescript": "^5",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=20"
  }
}
