{
  "name": "@simten/core",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@simten/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./simulator": {
      "@simten/source": "./src/simulator/index.ts",
      "types": "./dist/simulator/index.d.ts",
      "import": "./dist/simulator/index.js"
    },
    "./api": {
      "@simten/source": "./src/api/index.ts",
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./verilog": {
      "@simten/source": "./src/verilog/index.ts",
      "types": "./dist/verilog/index.d.ts",
      "import": "./dist/verilog/index.js"
    },
    "./circuit": {
      "@simten/source": "./src/circuit/index.ts",
      "types": "./dist/circuit/index.d.ts",
      "import": "./dist/circuit/index.js"
    },
    "./std": {
      "@simten/source": "./src/std/index.ts",
      "types": "./dist/std/index.d.ts",
      "import": "./dist/std/index.js"
    },
    "./sim": {
      "@simten/source": "./src/sim/index.ts",
      "types": "./dist/sim/index.d.ts",
      "import": "./dist/sim/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "acorn": "^8.14.1",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "fast-check": "^4.5.3",
    "typescript": "^5",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=20"
  }
}
