{
  "name": "@simten/embed",
  "version": "0.5.5",
  "description": "Embeddable interactive hardware circuits. Drop live, cycle-accurate simulations into any React app or HTML page.",
  "license": "Apache-2.0",
  "author": "Charles Harris",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simtenHQ/simten.git",
    "directory": "packages/embed"
  },
  "keywords": [
    "circuit-simulator",
    "hardware",
    "embed",
    "interactive",
    "react",
    "circuit",
    "digital-logic"
  ],
  "type": "module",
  "sideEffects": [
    "./src/webcomponent/index.ts",
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./nodes": "./src/components/nodes/index.ts",
    "./canvas": "./src/canvas/index.ts",
    "./styles.css": "./dist/styles.css",
    "./webcomponent": "./src/webcomponent/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./nodes": {
        "types": "./dist/components/nodes/index.d.ts",
        "import": "./dist/components/nodes/index.js"
      },
      "./canvas": {
        "types": "./dist/canvas/index.d.ts",
        "import": "./dist/canvas/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./webcomponent": {
        "default": "./dist/circuit-embed.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist *.tsbuildinfo && tsc -b && vite build",
    "analyze": "ANALYZE=true vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @simten/sandbox-app build && VITE_SANDBOX_ORIGIN=http://localhost:4174 pnpm build && cp e2e/fixtures/*.html dist/ && playwright test",
    "test:e2e:ui": "pnpm --filter @simten/sandbox-app build && VITE_SANDBOX_ORIGIN=http://localhost:4174 pnpm build && cp e2e/fixtures/*.html dist/ && playwright test --ui",
    "typecheck:tests": "tsc --noEmit -p tsconfig.check.json"
  },
  "dependencies": {
    "@r2wc/react-to-web-component": "^2.1.1",
    "@simten/core": "workspace:^",
    "@simten/ui": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.10.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=20"
  }
}
