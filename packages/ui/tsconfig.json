{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "references": [{ "path": "../core" }],
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  // Tests are excluded from the BUILD surface only — `tsc -b` would otherwise
  // emit them into dist. They are NOT unchecked: `tsconfig.check.json` includes
  // them, and `pnpm typecheck` runs it via the `typecheck:tests` script.
  //
  // (Vitest does not typecheck. It strips types with esbuild, so excluding a
  // file here used to mean nothing ever checked it.)
  "exclude": ["node_modules", "dist", "**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"]
}
