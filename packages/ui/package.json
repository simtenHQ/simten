{
  "name": "@simten/ui",
  "version": "0.1.8",
  "description": "Canvas, editor, and waveform React components for Simten. Built on React Flow with dagre layout and Zustand stores.",
  "license": "Apache-2.0",
  "author": "Charles Harris",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simtenHQ/simten.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "circuit-simulator",
    "hardware",
    "react",
    "react-flow",
    "circuit",
    "digital-logic",
    "canvas",
    "waveform"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./editor": "./src/editor/index.ts",
    "./editor/stores": "./src/editor/stores/index.ts",
    "./editor/types": "./src/editor/types/index.ts",
    "./editor/components": "./src/editor/components/index.ts",
    "./editor/hooks": "./src/editor/hooks/index.ts",
    "./nodes": "./src/nodes/index.ts",
    "./canvas": "./src/canvas/index.ts",
    "./waveform": "./src/waveform/WaveformViewer.tsx",
    "./sandbox": "./src/sandbox/index.ts",
    "./share": "./src/share/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./editor": {
        "types": "./dist/editor/index.d.ts",
        "import": "./dist/editor/index.js"
      },
      "./editor/stores": {
        "types": "./dist/editor/stores/index.d.ts",
        "import": "./dist/editor/stores/index.js"
      },
      "./editor/types": {
        "types": "./dist/editor/types/index.d.ts",
        "import": "./dist/editor/types/index.js"
      },
      "./editor/components": {
        "types": "./dist/editor/components/index.d.ts",
        "import": "./dist/editor/components/index.js"
      },
      "./editor/hooks": {
        "types": "./dist/editor/hooks/index.d.ts",
        "import": "./dist/editor/hooks/index.js"
      },
      "./nodes": {
        "types": "./dist/nodes/index.d.ts",
        "import": "./dist/nodes/index.js"
      },
      "./canvas": {
        "types": "./dist/canvas/index.d.ts",
        "import": "./dist/canvas/index.js"
      },
      "./waveform": {
        "types": "./dist/waveform/WaveformViewer.d.ts",
        "import": "./dist/waveform/WaveformViewer.js"
      },
      "./sandbox": {
        "types": "./dist/sandbox/index.d.ts",
        "import": "./dist/sandbox/index.js"
      },
      "./share": {
        "types": "./dist/share/index.d.ts",
        "import": "./dist/share/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist *.tsbuildinfo && tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@simten/core": "workspace:*",
    "@xyflow/react": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.0",
    "immer": "^11.1.3",
    "lucide-react": "^0.562.0",
    "lz-string": "^1.5.0",
    "nanoid": "^5.1.6",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.10"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "fast-check": "^4.5.3",
    "typescript": "^5",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=20"
  }
}
