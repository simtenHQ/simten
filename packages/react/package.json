{
  "name": "@simten/react",
  "version": "0.15.6",
  "description": "React for Simten circuits: useSimulation, the circuit canvas, clock controls and the code editor.",
  "license": "Apache-2.0",
  "author": "Charles Harris",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simtenHQ/simten.git",
    "directory": "packages/react"
  },
  "keywords": [
    "circuit-simulator",
    "hardware",
    "react",
    "react-flow",
    "circuit",
    "digital-logic",
    "canvas"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./code-editor": "./src/code-editor/index.ts",
    "./styles.css": "./src/styles/embed.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./code-editor": {
        "types": "./dist/code-editor/index.d.ts",
        "import": "./dist/code-editor/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist *.tsbuildinfo && node scripts/build-core-types.mjs && tsc -b && tailwindcss -i src/styles/embed.css -o dist/styles.css --minify",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @simten/sandbox-app build && VITE_SANDBOX_ORIGIN=http://localhost:4174 vite build -c e2e/vite.config.ts && playwright test",
    "lint": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.check.json"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@simten/core": "workspace:^",
    "@simten/sandbox": "workspace:^",
    "@typescript/ata": "^0.9.8",
    "@xyflow/react": "^12.10.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.4.0"
  },
  "peerDependencies": {
    "@monaco-editor/react": "^4.6.0",
    "monaco-editor": ">=0.40.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@monaco-editor/react": {
      "optional": true
    },
    "monaco-editor": {
      "optional": true
    }
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "monaco-editor": "^0.55.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
