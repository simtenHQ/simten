{
	"name": "@simten/web",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "pnpm --filter @simten/core build && vite dev --port 3001",
		"build": "pnpm --filter @simten/core build && node scripts/build.mjs",
		"analyze": "pnpm --filter @simten/core build && ANALYZE=true node scripts/build.mjs",
		"preview": "pnpm run build && vite preview",
		"test": "vitest run",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@cloudflare/vite-plugin": "^1.13.8",
		"@monaco-editor/react": "^4.7.0",
		"@radix-ui/react-dialog": "^1.1.15",
		"@simten/core": "workspace:*",
		"@simten/embed": "workspace:*",
		"@simten/ui": "workspace:*",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "^0.7.0",
		"@tanstack/react-router": "^1.132.0",
		"@tanstack/react-router-devtools": "^1.132.0",
		"@tanstack/react-router-ssr-query": "^1.131.7",
		"@tanstack/react-start": "^1.132.0",
		"@tanstack/router-plugin": "^1.132.0",
		"@typescript/ata": "^0.9.8",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"figlet": "^1.7.0",
		"framer-motion": "^12.34.0",
		"fumadocs-core": "^16.7.7",
		"fumadocs-mdx": "^14.2.11",
		"fumadocs-ui": "^16.7.7",
		"immer": "^11.1.3",
		"lucide-react": "^0.562.0",
		"monaco-editor": "^0.55.1",
		"nanoid": "^5.1.6",
		"radix-ui": "^1.4.3",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"sugar-high": "^1.1.0",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4.1.18",
		"zustand": "^5.0.10"
	},
	"devDependencies": {
		"@tanstack/devtools-vite": "^0.3.11",
		"@tanstack/router-cli": "^1.166.12",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/react": "^16.2.0",
		"@types/mdx": "^2.0.13",
		"@types/node": "^20",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^5.0.4",
		"jsdom": "^27.0.0",
		"rollup-plugin-visualizer": "^7.0.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.7.2",
		"vite": "^7.1.7",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^3.0.5",
		"wrangler": "^4.73.0"
	}
}
