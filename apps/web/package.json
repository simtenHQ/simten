{
  "name": "@simten/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "pnpm --filter @simten/core build && vite dev --port 3001",
    "dev:viewer": "pnpm --filter @simten/core build && vite dev -c vite.viewer.config.ts --port 3002",
    "build": "pnpm --filter @simten/core --filter @simten/react build && node scripts/build.mjs",
    "build:viewer": "pnpm --filter @simten/core --filter @simten/react build && vite build -c vite.viewer.config.ts",
    "analyze": "pnpm --filter @simten/core build && ANALYZE=true node scripts/build.mjs",
    "preview": "pnpm run build && vite preview",
    "test": "vitest run",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.13.8",
    "@monaco-editor/react": "^4.7.0",
    "@simten/shared": "workspace:*",
    "@simten/core": "workspace:*",
    "@simten/react": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "figlet": "^1.11.3",
    "fumadocs-core": "^16.7.7",
    "fumadocs-mdx": "^14.2.11",
    "fumadocs-ui": "^16.7.7",
    "lucide-react": "^0.562.0",
    "monaco-editor": "^0.55.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sugar-high": "^1.1.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.73.0"
  }
}
