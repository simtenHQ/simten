{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "synth",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"containers": [
		{
			"class_name": "SynthContainer",
			"image": "./Dockerfile",
			"max_instances": 5
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "SynthContainer",
				"name": "SYNTH_CONTAINER"
			}
		]
	},
	"migrations": [
		{
			"new_sqlite_classes": ["SynthContainer"],
			"tag": "v1"
		}
	],
	// Disable the public *.workers.dev URL — this service is only callable via
	// service binding from @simten/web. See issue #59.
	"workers_dev": false,
	"upload_source_maps": true
}
