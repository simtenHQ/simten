{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compiler",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "CompilerContainer",
      "image": "./Dockerfile",
      "max_instances": 5
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "CompilerContainer",
        "name": "COMPILER_CONTAINER"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["CompilerContainer"],
      "tag": "v1"
    }
  ],
  "workers_dev": false,
  "upload_source_maps": true
}
