# Cloudflare credentials for `pnpm run deploy:*` scripts.
#
# These override `wrangler login`'s cached credentials, which is useful
# when your global wrangler is logged into a different account (e.g. a
# work account) and you want this project to deploy to a personal one.
#
# Loaded by `dotenv-cli` via the root `deploy:*` scripts. To use:
#   1. cp .env.example .env
#   2. Fill in the values below
#   3. Run e.g. `pnpm run deploy:sandbox`

# API token from https://dash.cloudflare.com/profile/api-tokens
# Use the "Edit Cloudflare Workers" template when creating it.
CLOUDFLARE_API_TOKEN=

# Account ID from the right sidebar of any zone in the Cloudflare dashboard.
# Required when the API token has access to multiple accounts.
CLOUDFLARE_ACCOUNT_ID=
