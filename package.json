{
  "name": "simten",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "bench": "pnpm --filter @simten/core bench",
    "bench:browser": "tsx bench/browser.mts",
    "build": "pnpm -r build",
    "dev": "dotenv -- pnpm --filter @simten/web dev",
    "dev:game": "dotenv -- pnpm --filter @simten/game dev",
    "dev:sandbox": "pnpm --filter @simten/sandbox dev",
    "dev:embed": "pnpm --filter @simten/embed-page dev",
    "dev:synth": "pnpm --filter @simten/synth dev",
    "dev:verifier": "pnpm --filter @simten/verifier dev",
    "dev:compiler": "pnpm --filter @simten/compiler dev",
    "deploy": "pnpm run deploy:sandbox && pnpm run deploy:embed && pnpm run deploy:web && pnpm run deploy:game",
    "deploy:sandbox": "dotenv -- pnpm --filter @simten/sandbox run deploy",
    "deploy:embed": "dotenv -- pnpm --filter @simten/embed-page run deploy",
    "deploy:web": "dotenv -- pnpm --filter @simten/web run deploy",
    "deploy:game": "dotenv -- pnpm --filter @simten/game run deploy",
    "deploy:synth": "dotenv -- pnpm --filter @simten/synth run deploy",
    "deploy:verifier": "dotenv -- pnpm --filter @simten/verifier run deploy",
    "deploy:compiler": "dotenv -- pnpm --filter @simten/compiler run deploy",
    "dev:all": "pnpm --filter @simten/web dev & pnpm --filter @simten/sandbox dev & pnpm --filter @simten/embed-page dev",
    "test": "tsx scripts/check-exports.ts && tsx scripts/check-synth-limits.ts && pnpm -r test",
    "check-exports": "tsx scripts/check-exports.ts",
    "check-complexity": "tsx scripts/check-complexity.ts",
    "check-synth-limits": "tsx scripts/check-synth-limits.ts",
    "analytics": "dotenv -- tsx scripts/analytics.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "typecheck": "pnpm -r exec tsc --noEmit && pnpm -r --if-present run typecheck:tests && pnpm -r --if-present run typecheck:worker",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "sync-public": "rsync -av --delete --exclude='node_modules' --exclude='dist' --exclude='*.tsbuildinfo' --exclude='.turbo' ./packages/ /tmp/simten-public/packages/ && rsync -av --delete --exclude='node_modules' --exclude='dist' --exclude='*.tsbuildinfo' --exclude='.turbo' ./examples/ /tmp/simten-public/examples/",
    "sync-public:push": "pnpm sync-public && cd /tmp/simten-public && git add . && (git diff --cached --quiet || git commit -m \"sync $(date -u +%Y-%m-%dT%H:%M:%SZ)\" && git push)",
    "fpga:test": "pnpm --filter @simten/hardware-ulx3s run test",
    "fpga:verify": "pnpm --filter @simten/hardware-ulx3s run verify",
    "fpga:sim": "pnpm --filter @simten/hardware-ulx3s run sim",
    "fpga:regen-verilog": "pnpm --filter @simten/hardware-ulx3s run regen-verilog",
    "fpga:netlist-check": "pnpm --filter @simten/hardware-ulx3s run netlist:check",
    "fpga:build": "pnpm --filter @simten/hardware-ulx3s run build",
    "fpga:flash": "pnpm --filter @simten/hardware-ulx3s run flash",
    "fpga:run": "pnpm --filter @simten/hardware-ulx3s run run-on-fpga",
    "fpga:console": "TTY=$(ls /dev/cu.usbserial-* 2>/dev/null | head -1); [ -z \"$TTY\" ] && TTY=/dev/ttyUSB0; echo \"Opening $TTY (exit: Ctrl-A Ctrl-X)\"; picocom --nolock --noreset -b 115200 $TTY",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.58.2",
    "dotenv-cli": "^11.0.0",
    "knip": "5.88.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@8.8.0+sha1.9922e8b650d393700209ccd81e0ebdbcbe43b0d3",
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "@babel/core": "^7.29.7",
      "@hono/node-server": "^1.19.15",
      "body-parser": "^2.4.0",
      "brace-expansion@^1": "^1.1.16",
      "brace-expansion@^5": "^5.0.7",
      "browserslist": "^4.28.7",
      "compression": "^1.8.2",
      "dompurify": "^3.4.17",
      "esbuild": "^0.28.1",
      "express-rate-limit": "^8.2.2",
      "fast-uri": "^3.1.7",
      "image-size": "^2.0.3",
      "ip-address": "^10.3.1",
      "js-yaml@^3": "^3.15.2",
      "js-yaml@^4": "^4.3.2",
      "launch-editor": "^2.14.2",
      "path-to-regexp@^8": "^8.4.0",
      "picomatch@^4": "^4.0.4",
      "postcss": "^8.5.18",
      "postcss-selector-parser": "^7.1.6",
      "proxy-addr": "^2.0.8",
      "qs": "^6.16.1",
      "sharp": "^0.35.5",
      "shell-quote": "^1.9.0",
      "solid-js": "^1.9.17",
      "source-map-js": "^1.2.2",
      "undici": "^7.30.1",
      "ws": "^8.21.0",
      "zod@^4": "^4.6.6"
    }
  }
}
