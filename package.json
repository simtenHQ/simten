{
	"name": "turing-incomplete",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "pnpm -r build",
		"dev": "pnpm --filter tanstack dev",
		"test": "pnpm -r test",
		"lint": "pnpm -r lint",
		"changeset": "changeset",
		"release": "pnpm build && changeset publish",
		"sync-public": "rsync -av --delete --exclude='node_modules' --exclude='dist' --exclude='*.tsbuildinfo' --exclude='.turbo' ./packages/ /tmp/turing-complete-public/packages/ && rsync -av --delete --exclude='node_modules' --exclude='dist' --exclude='*.tsbuildinfo' --exclude='.turbo' ./examples/ /tmp/turing-complete-public/examples/",
		"sync-public:push": "pnpm sync-public && cd /tmp/turing-complete-public && git add . && (git diff --cached --quiet || git commit -m \"sync $(date -u +%Y-%m-%dT%H:%M:%SZ)\" && git push)"
	},
	"devDependencies": {
		"@changesets/cli": "^2.29.8",
		"typescript": "^5",
		"vitest": "^4.0.17"
	},
	"packageManager": "pnpm@8.8.0+sha1.9922e8b650d393700209ccd81e0ebdbcbe43b0d3"
}
